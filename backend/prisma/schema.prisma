generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum InquiryPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InquirySource {
  WEB
  PHONE
  EMAIL
  CHAT
  OTHER
}

enum MessageSenderType {
  CUSTOMER
  AGENT
  SYSTEM
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedInquiries Inquiry[]           @relation("AssignedAgent")
  messages          InquiryMessage[]
  attachments       InquiryAttachment[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Inquiry {
  id             String          @id @default(uuid())
  customerName   String
  customerEmail  String
  customerPhone  String?
  subject        String
  category       String?
  source         InquirySource   @default(WEB)
  status         InquiryStatus   @default(NEW)
  priority       InquiryPriority @default(MEDIUM)
  assignedUserId String?
  assignedUser   User?           @relation("AssignedAgent", fields: [assignedUserId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  closedAt       DateTime?

  messages    InquiryMessage[]
  attachments InquiryAttachment[]

  @@map("inquiries")
  @@index([status])
  @@index([priority])
  @@index([assignedUserId])
}

model InquiryMessage {
  id             String            @id @default(uuid())
  inquiryId      String
  inquiry        Inquiry           @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  senderType     MessageSenderType
  senderId       String?
  sender         User?             @relation(fields: [senderId], references: [id])
  content        String
  isInternalNote Boolean           @default(false)
  createdAt      DateTime          @default(now())

  attachments InquiryAttachment[]

  @@map("inquiry_messages")
  @@index([inquiryId])
}

model InquiryAttachment {
  id         String          @id @default(uuid())
  inquiryId  String
  inquiry    Inquiry         @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  messageId  String?
  message    InquiryMessage? @relation(fields: [messageId], references: [id])
  filePath   String
  fileType   String
  uploadedBy String?
  uploader   User?           @relation(fields: [uploadedBy], references: [id])
  createdAt  DateTime        @default(now())

  @@map("inquiry_attachments")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  oldValues  Json?
  newValues  Json?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@map("audit_logs")
  @@index([entityType, entityId])
}
